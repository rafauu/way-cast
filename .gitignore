# --- Build & Output Directories ---
build/
build-*/
bin/
lib/
out/
cmake-build-*/

# --- C++ Modules & Precompiled Headers ---
*.gcm             # GCC C++20/23 compiled module interfaces
*.pcm             # Clang C++20/23 compiled module interfaces
*.ifc             # MSVC C++20/23 module interfaces
*.bmi             # Generic binary module interface files
*.modmap          # CMake module dependency mapping files
*.gch             # GCC precompiled headers
*.pch             # MSVC precompiled headers

# --- Compilation & Linker Artifacts ---
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.elf
*.d               # Auto-generated dependency files

# --- CMake Artifacts ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeUserPresets.json
compile_commands.json
*_configure_manifest.txt

# --- Package Managers & Dependencies (CPM, vcpkg, Conan) ---
_deps/            # CPM.cmake / CMake FetchContent downloads
vcpkg_installed/
.conan/

# --- Ninja & Build Tool Logs ---
.ninja_deps
.ninja_log
build.ninja

# --- IDEs & Code Editors ---
# JetBrains CLion
.idea/

# Visual Studio Code (Keep project configurations if present, ignore workspace cache)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Visual Studio
.vs/
*.user
*.sln.docstates

# Vim / Emacs
*~
*.swp
*.swo

# --- Profiling & Coverage Tools ---
*.gcno
*.gcda
*.gcov
callgrind.out.*
gmon.out

# --- OS Specific ---
.DS_Store
Thumbs.db

{
    "name": "waycast",
    "version": "1.0.0",
    "dependencies": [
        {
            "name": "gstreamer",
            "features": [
                "plugins-base",
                "plugins-good",
                "plugins-bad",
                "plugins-ugly",
                "opus-base",
                "webrtc",
                "x264"
            ]
        },
        {
            "name": "gstreamer",
            "features": ["nvcodec"],
            "platform": "linux"
        },
        "gst-plugin-webrtc",
        "libsrtp",
        {
            "name": "pipewire",
            "platform": "linux"
        },
        "quill"
    ],
    "description": [
        "Custom ports:",
        "- gstreamer - does not expose certain options as features (va, d3d11, mf)",
        "- gst-plugin-webrtc - does not exist in vcpkg registry (rust package)",
        "- libsrtp - patched to fix printf format checker on mingw64",
        "- pipewire - does not expose certain options as features (gst plugin)"
    ]
}
